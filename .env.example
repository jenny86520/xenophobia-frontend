# Copy to .env.local and adjust.

# Backend address used by Server Components (pages render on the server).
# Can be an internal address, e.g. http://backend:3001 inside a container network.
BACKEND_URL=http://localhost:3001

# Public backend address, as visitors' browsers reach it. Used when BACKEND_URL is not
# set, and always for uploaded media (highlight videos at /media/videos/...).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
